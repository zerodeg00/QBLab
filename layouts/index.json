{{- $pages := slice -}}
{{- range .Site.RegularPages -}}
  {{- if and (not .Draft) (not .Params.unlisted) -}}
    {{- $pages = $pages | append . -}}
  {{- end -}}
{{- end -}}
[
{{- range $i, $p := $pages }}
  {{- if $i }},{{ end }}
  {
    "title": {{ $p.Title | jsonify }},
    "url": {{ $p.RelPermalink | jsonify }},
    "description": {{ (default "" $p.Description) | jsonify }},
    "tags": {{ (default (slice) $p.Params.tags) | jsonify }},
    "date": {{ $p.Date.Format "2006-01-02" | jsonify }},
    "content": {{ (substr $p.Plain 0 300) | jsonify }},
    "cover": {{ (default "" $p.Params.cover) | jsonify }}
  }
{{- end }}
]
